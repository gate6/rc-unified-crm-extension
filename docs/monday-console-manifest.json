    {
      "path": "cachedData.extensionInfo.contact.department",
      "id": "departmentName"
    }
  ],
  "description": "",
  "serverSideLogging": {
    "additionalFields": [],
    "rcClientId": "Y4m1YREFKbXdDoet5djv46",
    "url": "https://crm-logging.labs.ringcentral.com",
    "useAdminAssignedUserToken": false
  },
  "releaseNotesUrl": "https://ringcentral.github.io/rc-unified-crm-extension/release-notes/",
  "contactPageUrl": "https://{hostname}/boards/{contactType}/pulses/{contactId}",
