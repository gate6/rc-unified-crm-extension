      "accessTokenUri": "https://auth.monday.com/oauth2/token",
      "customState": "platform=gate6.monday",
      "scope": "me:read users:read boards:read boards:write updates:write",
      "adminManaged": {
        "setupNotes": "Enter your Monday.com OAuth app credentials. Only Client ID, Client Secret, and Hostname are required — the other fields are optional and will be filled automatically by the server. If needed: Authorization URI = https://auth.monday.com/oauth2/authorize | Token URI = https://auth.monday.com/oauth2/token | Scopes = me:read users:read boards:read boards:write updates:write",
        "enabled": true
      }
    }
  },
  "displayName": "Monday",
